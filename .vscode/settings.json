{
  // Pandoc Citer: Standard-Bib fuer Autovervollstaendigung von [@keys]
  "PandocCiter.DefaultBibs": ["references.bib"],

  // Code Spell Checker: default Englisch (fuer Deutsch pro Datei <!-- cspell:language de -->)
  "cSpell.language": "en",

  // Harper (wirksame per-Projekt-Config — harper-ls liest KEINE harper-ls.toml aus dem Projekt!)
  "harper.dialect": "American",
  "harper.diagnosticSeverity": "warning",
  "harper.linters.LongSentences": false,
  "harper.linters.AvoidContractions": true,
  // Quick Fix "Add to dictionary" soll ins projektweite .harper-dictionary.txt schreiben:
  "harper.workspaceDictPath": ".harper-dictionary.txt",
  "harper.codeActions.forceStable": true
}
